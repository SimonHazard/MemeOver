{
	"name": "@memeover/ui",
	"private": true,
	"version": "1.0.1",
	"type": "module",
	"exports": {
		"./components/ui/*": {
			"types": "./dist/components/ui/*.d.ts",
			"import": "./dist/components/ui/*.js"
		},
		"./components/branded/*": {
			"types": "./dist/components/branded/*.d.ts",
			"import": "./dist/components/branded/*.js"
		},
		"./lib/*": {
			"types": "./dist/lib/*.d.ts",
			"import": "./dist/lib/*.js"
		},
		"./theme.css": "./src/theme.css"
	},
	"scripts": {
		"build": "tsup",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^1.39.0",
		"radix-ui": "^1.5.0",
		"sonner": "^2.0.8",
		"tailwind-merge": "^3.7.0"
	},
	"peerDependencies": {
		"react": "^19.2.8",
		"react-dom": "^19.2.8"
	},
	"devDependencies": {
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.5",
		"tsup": "^8.5.1",
		"typescript": "~6.0.3"
	}
}
