{
	"name": "@memeover/ui",
	"private": true,
	"version": "1.0.1",
	"type": "module",
	"exports": {
		"./components/ui/*": {
			"types": "./src/components/ui/*.tsx",
			"import": "./src/components/ui/*.tsx"
		},
		"./components/branded/*": {
			"types": "./src/components/branded/*.tsx",
			"import": "./src/components/branded/*.tsx"
		},
		"./lib/*": {
			"types": "./src/lib/*.ts",
			"import": "./src/lib/*.ts"
		},
		"./theme.css": "./src/theme.css"
	},
	"scripts": {
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@base-ui/react": "^1.9.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^1.81.0",
		"sonner": "^2.0.8",
		"tailwind-merge": "^3.7.1"
	},
	"peerDependencies": {
		"react": "^19.3.1",
		"react-dom": "^19.3.1"
	},
	"devDependencies": {
		"@types/react": "^19.3.3",
		"@types/react-dom": "^19.3.0",
		"typescript": "~7.0.2"
	}
}
