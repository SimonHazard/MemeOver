{
  "name": "memeover",
  "private": true,
  "packageManager": "bun@1.4.2",
  "workspaces": ["bot", "app", "shared", "packages/ui", "site"],
  "scripts": {
    "dev:app": "bun run --cwd app tauri dev",
    "dev:bot": "bun run --cwd bot dev",
    "dev:site": "bun run --cwd site dev",
    "build:app": "bun run --cwd app build && bun run --cwd app tauri build",
    "build:site": "bun run --cwd site build",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "format": "biome format --write",
    "check": "biome check",
    "check:versions": "bun scripts/check-versions.ts",
    "check:fix": "biome check --write",
    "typecheck": "bun run typecheck:bot && bun run typecheck:app && bun run typecheck:shared && bun run typecheck:ui && bun run typecheck:browser",
    "typecheck:bot": "bun run --cwd bot typecheck",
    "typecheck:app": "bun run --cwd app typecheck",
    "typecheck:shared": "bun run --cwd shared typecheck",
    "typecheck:ui": "bun run --cwd packages/ui typecheck",
    "test": "bun run test:unit && bun run test:mocked",
    "test:unit": "bun test ./app/src ./bot/src ./shared/src ./site/src ./packages/ui/src ./scripts --path-ignore-patterns='**/*.mocked.test.{ts,tsx}'",
    "test:mocked": "bun scripts/run-mocked-tests.ts",
    "test:browser": "playwright test",
    "typecheck:browser": "bun run --cwd app typecheck:browser"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.63.0"
  },
  "overrides": {
    "miniflare": {
      "sharp": "0.35.5",
      "undici": "7.30.1"
    }
  }
}
