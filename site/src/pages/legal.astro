---
import LegalDocument from "@/components/legal-document.astro";
import BaseLayout from "@/layouts/base-layout.astro";

const title = "Terms & Privacy — MemeOver";
const description = "Terms of use, privacy, and legal information for MemeOver.";
---

<BaseLayout title={title} description={description}>
	<LegalDocument
		kicker="Legal"
		title="Terms & Privacy"
		description="MemeOver displays media, reactions, and text sent in configured Discord channels on your screen. This page explains the usage rules and the data needed to run the service."
		updated="Last updated: May 27, 2026"
	>
		<section>
			<h2>Publisher</h2>
			<p>
				MemeOver is published by Simon Hazard, in France, as a personal and non-professional
				project. For support, legal, privacy, or deletion requests, contact
				<a href="mailto:support@simonhazard.com">support@simonhazard.com</a>.
			</p>
		</section>

		<section>
			<h2>Hosting And Code</h2>
			<p>
				The public website is hosted on Cloudflare Workers by Cloudflare, Inc., 101 Townsend St,
				San Francisco, CA 94107, United States. The Discord bot is self-hosted by the publisher.
				The source code is hosted on
				<a href="https://github.com/SimonHazard/MemeOver">GitHub</a> and distributed under the
				<a href="https://github.com/SimonHazard/MemeOver/blob/main/LICENSE">MIT License</a>.
			</p>
		</section>

		<section>
			<h2>Terms Of Use</h2>
			<p>
				By adding the bot to a Discord server or using the desktop app, you agree to use MemeOver
				in good faith, in compliance with Discord's rules, the relevant server rules, and the law.
			</p>
			<ul>
				<li>Only authorized people should configure MemeOver on a Discord server.</li>
				<li>Server managers should inform members which channels are watched by the bot.</li>
				<li>
					The MemeOver connection token must stay private and can be renewed with
					<code>/memeover rotate</code>.
				</li>
				<li>
					Do not use MemeOver to harass, spam, bypass permissions, monitor members, or broadcast
					illegal, sensitive, or unauthorized content.
				</li>
			</ul>
		</section>

		<section>
			<h2>Data Used</h2>
			<p>
				MemeOver only uses data needed to forward Discord messages to connected overlays and to
				keep technical logs useful for fixing bugs, abuse, and service issues:
			</p>
			<ul>
				<li>
					<strong>Discord server configuration:</strong> server ID, watched channel IDs, and a
					random MemeOver connection token.
				</li>
				<li>
					<strong>Discord events sent to overlays:</strong> server, channel, message and author
					IDs, username, optional server display name, avatar URL, media URL, media type,
					optional short text, reaction data, and timestamp.
				</li>
				<li>
					<strong>Connected desktop app data:</strong> server ID, token, WebSocket URL, overlay
					settings, profiles, and a local history of the last 50 displayed text/media items for
					replay.
				</li>
				<li>
					<strong>Technical logs:</strong> event names, media type, media host, hashed Discord
					references, hashed media path, and technical errors. Tokens, full media URLs, and
					message text are redacted from logs.
				</li>
			</ul>
		</section>

		<section>
			<h2>No Trackers</h2>
			<p>
				The website does not use advertising, analytics, or marketing trackers. It may keep a
				local theme preference in your browser so the interface stays in the mode you selected;
				that preference is not used to track you.
			</p>
		</section>

		<section>
			<h2>Retention And Deletion</h2>
			<p>
				Server configuration stays stored until a server manager runs <code>/memeover remove</code>
				or a deletion request is sent. Realtime Discord events are forwarded to connected overlays
				and are not intentionally stored by the hosted bot after delivery. Local replay history
				stays on your device until cleared.
			</p>
			<p>
				To ask for access, deletion, or another privacy action, email
				<a href="mailto:support@simonhazard.com">support@simonhazard.com</a> with enough context
				to identify the relevant server or logs, such as the Discord server ID. You may also
				contact the <a href="https://www.cnil.fr/fr/plaintes">CNIL</a> if you believe your rights
				are not respected.
			</p>
		</section>

		<section>
			<h2>Responsibility</h2>
			<p>
				MemeOver is provided free of charge, as is, without uptime or compatibility guarantees.
				People who send media, text, stickers, or reactions through Discord remain responsible for
				the legality and rights attached to that content. MemeOver is not affiliated with Discord,
				Cloudflare, GitHub, Tenor, Giphy, Imgur, or Better Stack.
			</p>
		</section>
	</LegalDocument>
</BaseLayout>
