---
import { getLangFromUrl, getTranslations } from "@/i18n";
import BaseLayout from "@/layouts/base-layout.astro";

const dict = getTranslations(getLangFromUrl(Astro.url));
---
<BaseLayout title={`${dict.selfHost.title} — MemeOver`} description={dict.selfHost.description}>
 <section class="mx-auto max-w-3xl px-4 pt-28 pb-16 space-y-8"><h1 class="font-display text-3xl">{dict.selfHost.title}</h1><p class="text-muted-foreground">{dict.selfHost.description}</p>
 <article class="border-2 border-foreground rounded-xl bg-card p-6 shadow-nb-md space-y-4"><h2 class="font-display text-xl">{dict.selfHost.appTitle}</h2><ol class="list-decimal pl-5 space-y-3">{dict.selfHost.appSteps.map(step => <li>{step}</li>)}</ol></article>
 <article class="border-2 border-foreground rounded-xl bg-card p-6 shadow-nb-md space-y-4"><h2 class="font-display text-xl">{dict.selfHost.dockerTitle}</h2><p>{dict.selfHost.dockerNote}</p><pre class="overflow-x-auto bg-muted border-2 border-border p-4 text-sm"><code>docker compose up -d --build</code></pre><a href="https://github.com/SimonHazard/MemeOver#readme" class="underline underline-offset-4">{dict.selfHost.guideLabel}</a></article>
 </section>
</BaseLayout>
