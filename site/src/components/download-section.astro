---
import { Apple, Bot, Download, Laptop, PackageOpen } from "lucide-react";
import type { Locale } from "@/i18n";
import { getLocalizedPath, getTranslations } from "@/i18n";
import { botInviteHref } from "@/lib/bot-invite";
import { formatAssetSize, latestRelease, RELEASE_FALLBACK_URL } from "@/lib/latest-release";

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;
const dict = getTranslations(lang);

const release = await latestRelease();
const platforms = [
	{
		id: "windows",
		asset: release?.assets.windowsExe,
		name: dict.download.windows,
		formats: dict.download.windowsFormats,
		Icon: Laptop,
	},
	{
		id: "macos",
		asset: release?.assets.macDmg,
		name: dict.download.macos,
		formats: dict.download.macosFormats,
		Icon: Apple,
	},
	{
		id: "linux",
		asset: release?.assets.linuxAppImage,
		name: dict.download.linux,
		formats: dict.download.linuxFormats,
		Icon: PackageOpen,
	},
];

const stepBadge =
	"absolute -left-3 -top-3 flex size-8 items-center justify-center rounded-lg border-2 border-foreground bg-primary font-display text-sm text-primary-foreground shadow-[2px_2px_0px_0px_var(--nb-shadow)]";
const textLink =
	"w-fit font-display text-sm tracking-wide text-muted-foreground underline decoration-foreground/30 underline-offset-4 transition-[color,text-decoration-color] duration-200 hover:text-foreground hover:decoration-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-card";
---

<section data-reveal id="download" class="scroll-mt-24 px-4 py-20">
	<div class="mx-auto flex max-w-6xl flex-col gap-10">
		<div class="flex max-w-2xl flex-col gap-4">
			<h2 class="text-balance font-display text-3xl tracking-wide sm:text-4xl">
				{dict.download.title}
			</h2>
			<p class="text-lg text-muted-foreground">
				{dict.download.description}
			</p>
		</div>

		<div class="grid grid-cols-1 gap-8 lg:grid-cols-[0.8fr_1.2fr] lg:items-start">
			<article class="relative flex flex-col gap-4 rounded-3xl border-2 border-foreground bg-card p-6 shadow-[5px_5px_0px_0px_var(--nb-shadow)]">
				<span class={stepBadge} aria-hidden="true">1</span>
				<h3 class="font-display text-xl tracking-wide">{dict.download.botStepTitle}</h3>
				<p class="leading-relaxed text-muted-foreground">{dict.download.botStepDescription}</p>
				{botInviteHref ? (
					<a
						href={botInviteHref}
						target="_blank"
						rel="noopener noreferrer"
						class="mt-2 inline-flex w-full items-center justify-center gap-2 rounded-xl border-2 border-foreground bg-secondary px-6 py-3 font-display text-base tracking-wide text-secondary-foreground shadow-[3px_3px_0px_0px_var(--nb-shadow)] transition-[box-shadow,translate,scale] duration-200 ease-out hover:shadow-[4px_4px_0px_0px_var(--nb-shadow)] [@media(hover:hover)]:motion-safe:hover:-translate-y-0.5 motion-safe:active:scale-[0.98] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-card sm:w-fit"
					>
						<Bot className="size-5" aria-hidden="true" />
						{dict.download.botStepCta}
					</a>
				) : (
					<span class="mt-2 inline-flex w-full cursor-not-allowed items-center justify-center gap-2 rounded-xl border-2 border-foreground/30 bg-muted px-6 py-3 font-display text-base tracking-wide text-muted-foreground opacity-50 sm:w-fit">
						<Bot className="size-5" aria-hidden="true" />
						{dict.download.botStepCta}
					</span>
				)}
				<a href={getLocalizedPath(lang, "/commands")} class={textLink}>
					{dict.download.commandsLink}
				</a>
			</article>

			<article class="relative flex flex-col gap-4 rounded-3xl border-2 border-foreground bg-card p-4 shadow-[5px_5px_0px_0px_var(--nb-shadow)] sm:p-5">
				<span class={stepBadge} aria-hidden="true">2</span>
				<div class="flex flex-col gap-2 px-1 pt-1 sm:px-2">
					<h3 class="font-display text-xl tracking-wide">{dict.download.appStepTitle}</h3>
					<p class="leading-relaxed text-muted-foreground">{dict.download.appStepDescription}</p>
				</div>
				<div class="grid grid-cols-1 gap-3 md:grid-cols-3">
					{platforms.map((platform) => {
						const Icon = platform.Icon;
						return (
							<a
								href={platform.asset?.url ?? RELEASE_FALLBACK_URL}
								target="_blank"
								rel="noopener noreferrer"
								data-platform={platform.id}
								class="group flex min-h-40 flex-col justify-between rounded-2xl border-2 border-foreground bg-background p-5 shadow-[2px_2px_0px_0px_var(--nb-shadow)] transition-[box-shadow,transform,translate,background-color] ease-out duration-200 [@media(hover:hover)]:motion-safe:hover:-translate-y-1 motion-safe:active:translate-y-0 active:shadow-none hover:bg-muted hover:shadow-[4px_4px_0px_0px_var(--nb-shadow)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-card"
							>
								<div class="flex items-center justify-between gap-2">
									<div class="flex size-12 items-center justify-center rounded-xl border-2 border-foreground bg-primary">
										<Icon className="size-6" aria-hidden="true" />
									</div>
									<span class="hidden rounded-lg border-2 border-foreground bg-secondary px-2 py-1 font-display text-[10px] tracking-wide text-secondary-foreground group-data-detected:inline-flex">
										{dict.download.detected}
									</span>
									<Download className="size-5 text-muted-foreground transition-colors duration-200 group-hover:text-foreground group-data-detected:hidden" aria-hidden="true" />
								</div>
								<div class="flex flex-col gap-1">
									<span class="font-display text-lg tracking-wide">
										{platform.name}
									</span>
									<span class="font-display text-xs tracking-wide text-muted-foreground">
										{platform.formats}
										{platform.asset && release && <span class="block text-xs">v{release.version} · {formatAssetSize(platform.asset.size)}</span>}
									</span>
								</div>
							</a>
						);
					})}
				</div>
				<div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-3 px-1 text-xs sm:px-2">
					{release && (
						<p class="flex flex-wrap items-center gap-x-4 gap-y-1">
							<span class="text-muted-foreground">{dict.download.otherFormats}</span>
							<a href={release.assets.windowsMsi.url} class="underline underline-offset-4">Windows MSI</a>
							<a href={release.assets.linuxDeb.url} class="underline underline-offset-4">Linux deb</a>
							<a href={release.assets.linuxRpm.url} class="underline underline-offset-4">Linux rpm</a>
						</p>
					)}
					<a href="https://github.com/SimonHazard/MemeOver/releases" target="_blank" rel="noopener noreferrer" class={textLink}>
						{dict.download.allReleases}
					</a>
				</div>
			</article>
		</div>
	</div>
</section>

<script>
	// Flags the card matching the visitor's OS; phones and tablets get no recommendation.
	const nav = navigator as Navigator & { userAgentData?: { platform: string } };
	const platform = (nav.userAgentData?.platform || navigator.userAgent).toLowerCase();
	const isMobile = /android|iphone|ipad|ipod/.test(navigator.userAgent.toLowerCase());
	const detected = isMobile
		? null
		: platform.includes("win")
			? "windows"
			: platform.includes("mac")
				? "macos"
				: platform.includes("linux")
					? "linux"
					: null;
	if (detected) document.querySelector(`[data-platform="${detected}"]`)?.setAttribute("data-detected", "");
</script>
