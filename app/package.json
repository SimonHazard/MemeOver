{
	"name": "@memeover/app",
	"private": true,
	"version": "1.13.4",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"typecheck": "tsc --noEmit",
		"typecheck:browser": "tsc --project ../tsconfig.browser.json",
		"test": "bun test ./src --path-ignore-patterns='**/*.mocked.test.{ts,tsx}'",
		"build": "tsc && vite build",
		"preview": "vite preview",
		"build:browser": "vite build --config test/browser/vite.config.ts --outDir dist-browser",
		"preview:browser": "vite preview --config test/browser/vite.config.ts --outDir dist-browser",
		"test:native": "node test/native/smoke.mjs",
		"tauri": "tauri"
	},
	"dependencies": {
		"@memeover/shared": "workspace:*",
		"@memeover/ui": "workspace:*",
		"@tanstack/react-form": "^1.33.6",
		"@tanstack/react-query": "^5.108.4",
		"@tanstack/react-router": "^1.170.46",
		"@tauri-apps/api": "^2.12.5",
		"@tauri-apps/plugin-autostart": "^2.7.0",
		"@tauri-apps/plugin-dialog": "^2.8.4",
		"@tauri-apps/plugin-opener": "^2.7.3",
		"@tauri-apps/plugin-process": "^2.4.0",
		"@tauri-apps/plugin-store": "^2.5.1",
		"@tauri-apps/plugin-updater": "^2.14.1",
		"framer-motion": "^14.14.0",
		"i18next": "^26.7.2",
		"lucide-react": "^1.81.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-i18next": "^17.1.13",
		"react-markdown": "^10.1.0",
		"sonner": "^2.0.8",
		"ts-pattern": "^5.9.2",
		"zod": "^4.6.7",
		"zustand": "^5.1.0"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.3.5",
		"@tanstack/router-plugin": "^1.169.0",
		"@tauri-apps/cli": "^2.12.6",
		"@types/node": "^26.6.11",
		"@types/react": "^19.3.3",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.3.0",
		"@wdio/tauri-service": "1.5.1",
		"bun-types": "1.4.2",
		"tailwindcss": "^4.3.5",
		"tw-animate-css": "^1.4.0",
		"typescript": "~7.0.2",
		"vite": "^8.4.0"
	}
}
